# Sao chép file này thành .env rồi điền giá trị thật. KHÔNG commit/nộp file .env.
# ==========================================
# Application

# ==========================================
# Database
# ==========================================
DB_URL=<điền-giá-trị-của-bạn>
DB_USERNAME=<điền-giá-trị-của-bạn>
DB_PASSWORD=<điền-giá-trị-của-bạn>


# ==========================================
# JPA / Hibernate
# ==========================================
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true
JPA_FORMAT_SQL=true


# ==========================================
# Mail
# ==========================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=<điền-giá-trị-của-bạn>
MAIL_PASSWORD=<điền-giá-trị-của-bạn>
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_SMTP_STARTTLS_REQUIRED=true


# ==========================================
# JWT
# ==========================================
JWT_SECRET=<điền-giá-trị-của-bạn>
JWT_ACCESS_TOKEN_EXPIRATION=900000
JWT_REFRESH_TOKEN_EXPIRATION=604800000


# ==========================================
# Async Thread Pool
# ==========================================
ASYNC_CORE_SIZE=5
ASYNC_MAX_SIZE=10


# ==========================================
# Server
# ==========================================
SERVER_PORT=8080
APP_FRONTEND_URL=<điền-giá-trị-của-bạn>

# ==========================================
# Swagger
# ==========================================
SWAGGER_API_DOCS_PATH=/api-docs
SWAGGER_UI_PATH=/swagger-ui.html


# ==========================================
# Logging
# ==========================================
LOGGING_APP_LEVEL=DEBUG
LOGGING_SECURITY_LEVEL=INFO


# ==========================================
# Seed Users
# ==========================================
SEED_ADMIN_PASSWORD=<điền-giá-trị-của-bạn>
SEED_FACILITY_MANAGER_PASSWORD=<điền-giá-trị-của-bạn>
SEED_BUSINESS_MANAGER_PASSWORD=<điền-giá-trị-của-bạn>
SEED_STAFF_PASSWORD=<điền-giá-trị-của-bạn>
SEED_CUSTOMER_PASSWORD=<điền-giá-trị-của-bạn>


# ==========================================
# VNPay Sandbox
# ==========================================
VNPAY_TMN_CODE=<điền-giá-trị-của-bạn>
VNPAY_HASH_SECRET=<điền-giá-trị-của-bạn>
VNPAY_URL=<điền-giá-trị-của-bạn>
VNPAY_RETURN_URL=<điền-giá-trị-của-bạn>


# ==========================================
# Cloudinary
# ==========================================
CLOUDINARY_CLOUD_NAME=<điền-giá-trị-của-bạn>
CLOUDINARY_API_KEY=<điền-giá-trị-của-bạn>
CLOUDINARY_API_SECRET=<điền-giá-trị-của-bạn>

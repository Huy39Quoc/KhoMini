+    @Transactional
+    public void expireStaleNotifications() {
+        Instant now = Instant.now();
+        List<Waitlist> expired = waitlistRepository.findExpiredOffersForUpdate(
+                WaitlistStatus.NOTIFIED, now);
+        for (Waitlist entry : expired) {
